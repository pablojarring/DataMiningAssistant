# Copia este archivo a .env y ajusta si hace falta. Valores por defecto pensados
# solo para desarrollo local — nunca uses estos secretos en producción.

# --- PostgreSQL ---
POSTGRES_USER=dataforge
POSTGRES_PASSWORD=dataforge_dev_password
POSTGRES_DB=dataforge
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://dataforge:dataforge_dev_password@postgres:5432/dataforge

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=dataforge
MINIO_ROOT_PASSWORD=dataforge_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=dataforge-datasets

# --- Redis (broker de Celery, se usa desde Fase 1) ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Backend ---
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://dataforge.localhost

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://dataforge.localhost/api

# --- Traefik ---
# Si el puerto 80 ya está ocupado en tu maquina, cambia esto (p. ej. 8081)
# y entra por http://dataforge.localhost:8081
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
